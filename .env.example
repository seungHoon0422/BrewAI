# 복사해서 .env 로 쓴다 (커밋 금지). PC마다 따로 둔다.

# ── 모델 (P1은 하나만 채워도 됨) — LiteLLM 프록시가 읽는다
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── LiteLLM 프록시 (로컬, npm run gateway) — 모델 등록은 infra/litellm/config.yaml 에만
# 만들기: node -e "console.log('sk-'+require('crypto').randomBytes(32).toString('hex'))"  (sk-1234 · 빈 값 · 예시 값 · 짧은 값은 npm run gateway 가 거부)
LITELLM_MASTER_KEY=
# 127.0.0.1 로 쓴다 (윈도우에서 localhost 는 ::1 로 풀려 127.0.0.1 에만 뜬 게이트웨이에 못 붙는다)
LLM_GATEWAY_URL=http://127.0.0.1:4000
# LLM_GATEWAY_KEY=        # P2 서비스 전용 virtual key. P1 은 비우면 LITELLM_MASTER_KEY 를 쓴다
# LITELLM_LICENSE 는 절대 넣지 않는다 (GHSA-w4c7-34wj-hqm8, 1.106.5 전까지 · npm run gateway 가 거부)

# ── conductor (npm run api → http://127.0.0.1:8787)
PYDANTIC_AI_NO_BANNER=1
# CONDUCTOR_DEFAULT_MODEL=brewai-mock          # 없으면 게이트웨이 순서의 첫 채팅 모델 (키 없는 mock)
# CONDUCTOR_DESKTOP_ORIGINS=app://brewai,http://localhost:5173
# CONDUCTOR_ADMIN_ORIGINS=http://localhost:5174,http://localhost:4174
# 데스크톱·관리자는 .env 를 읽지 않는다: BREWAI_API_URL(데스크톱 셸 env) · VITE_BREWAI_API_URL(관리자 빌드 때)
# 다른 env 파일로 띄우기 (시험용): BREWAI_ENV_FILE=<경로> npm run gateway / npm run api

# ── Langfuse Cloud (OTLP/HTTP 만, gRPC 불가) — 리전별 host 는 https://langfuse.com/security/data-regions
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_SERVICE_NAME=conductor
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# base64(public:secret) 를 넣는다. ingestion-version=4 가 없으면 반영이 최대 10분 늦다.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64(pk:sk)>,x-langfuse-ingestion-version=4
