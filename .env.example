# 복사해서 .env 로 쓴다 (커밋 금지). PC마다 따로 둔다.

# ── 모델 (P1은 하나만 채워도 됨) — LiteLLM 프록시가 읽는다
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── LiteLLM 프록시 (로컬 Docker npm run stack · 대체 npm run gateway) — 모델 등록 = infra/litellm/config.yaml + 관리 화면 http://127.0.0.1:4000/ui (Docker 스택만, DB 모드)
# 비워 두면 npm run stack 이 만든다. venv 만 쓰는 PC: node -e "console.log('sk-'+require('crypto').randomBytes(32).toString('hex'))"  (sk-1234 · 빈 값 · 예시 값 · 짧은 값은 거부)
# 관리 화면 로그인 = admin / 이 값
LITELLM_MASTER_KEY=
# LiteLLM 전용 Postgres(litellm-db, 호스트에 안 열림) — 비워 두면 npm run stack 이 만든다 · 처음 뜬 뒤 바꾸지 않는다 (DB 는 첫 값만 기억)
LITELLM_DB_PASSWORD=
# 주의: UI 로 저장한 provider 키를 이 값으로 암호화한다 → 처음 쓴 뒤 절대 바꾸거나 지우지 않는다 (바꾸면 저장한 키를 못 읽음 · 지우면 stack 이 멈춤)
#       바꿔야 하면 npm run stack:reset -- --yes (UI 로 넣은 모델·키 다 지워짐) 먼저
LITELLM_SALT_KEY=
# 127.0.0.1 로 쓴다 (윈도우에서 localhost 는 ::1 로 풀려 127.0.0.1 에만 뜬 게이트웨이에 못 붙는다)
LLM_GATEWAY_URL=http://127.0.0.1:4000
# LLM_GATEWAY_KEY=        # P2 서비스 전용 virtual key. P1 은 비우면 LITELLM_MASTER_KEY 를 쓴다
# LITELLM_LICENSE 는 절대 넣지 않는다 (GHSA-w4c7-34wj-hqm8, 1.106.5 전까지 · npm run gateway · npm run stack 이 거부)

# ── conductor (npm run api → http://127.0.0.1:8787)
PYDANTIC_AI_NO_BANNER=1
# CONDUCTOR_DEFAULT_MODEL=brewai-mock          # 없으면 게이트웨이 순서의 첫 채팅 모델 (키 없는 mock)
# CONDUCTOR_DESKTOP_ORIGINS=app://brewai,http://localhost:5173
# CONDUCTOR_ADMIN_ORIGINS=http://localhost:5174,http://localhost:4174
# 데스크톱·관리자는 .env 를 읽지 않는다: BREWAI_API_URL(데스크톱 셸 env) · VITE_BREWAI_API_URL(관리자 빌드 때)
# 다른 env 파일로 띄우기 (시험용): BREWAI_ENV_FILE=<경로> npm run gateway / npm run api

# ── 로그인 (ADR-0010 · slice 03). 첫 관리자 = DB 에 사용자가 없을 때만 이 값으로 만든다 (그 뒤엔 안 쓰임)
#    비워 두면 npm run dev(stack.mjs) 가 dev@brewai.local + 무작위 24자를 넣는다 (Docker 없는 PC = node scripts/stack.mjs secrets)
#    직접 정한 비밀번호에 공백이 있으면 "따옴표"로 감싸기 (안 그러면 uv 가 이 파일을 거기서 못 읽어 첫 관리자가 안 생긴다)
BREWAI_ADMIN_EMAIL=
BREWAI_ADMIN_PASSWORD=
# CONDUCTOR_PASSWORD_MIN=15                       # 비밀번호 최소 길이 (OWASP · MFA 없음). 8 아래로는 못 내린다
# 테스트 관리자 admin / admin (지금은 테스트 단계). npm run dev(./run.sh · start 파일)는 이 줄이 없으면 1 로 켠다
#   conductor 를 켤 때마다 로그인 ID admin · 비밀번호 admin · instance admin 으로 맞춘다 (없으면 만들고 · DB 가 비었으면 첫 관리자)
#   CONDUCTOR_PUBLIC_URL · CONDUCTOR_ADMIN_URL 이 이 PC(loopback) 주소일 때만 켜진다 · E2E 에서는 꺼짐
#   끄기 = 0 → 그 계정은 잠긴다 (다시 1 이면 풀린다 · 줄이 없는데 npm run api 만 켜면 로그인만 막고 계정 · 세션은 그대로). 이 계정만 비밀번호 길이 규칙을 건너뛴다
# BREWAI_TEST_ADMIN=0
# CONDUCTOR_DB_PATH=.data/conductor.sqlite3       # 바꾸기 전 DB 는 <파일>.v1.bak 으로 백업된다 (v1 → v2)
# CONDUCTOR_PUBLIC_URL=http://127.0.0.1:8787      # 시스템 브라우저가 여는 conductor 주소 (Google 콜백) · 운영 = https 도메인
# CONDUCTOR_ADMIN_URL=http://localhost:5174       # 관리자 콘솔 주소 (Vite proxy · 관리자 Google 콜백) · https 면 쿠키 = __Host- + Secure
# Google 로그인 (선택 · 둘 다 비면 'Google로 계속' 버튼이 숨는다). console.cloud.google.com › Client 'Web application'
#   redirect URI = http://127.0.0.1:8787/api/auth/google/callback · http://localhost:5174/api/auth/google/callback (두 PC 같은 값 · 커밋 금지)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_ISSUER=https://accounts.google.com       # https 만. http(mock) 는 BREWAI_E2E=1 + CONDUCTOR_PUBLIC_URL 이 loopback 일 때만 (E2E 전용)

# ── MCP 연결 (ADR-0013 · slice 05). 사용자별 MCP 인증정보(OAuth 토큰)를 이 키로 AES-GCM 암호화해 DB 에 둔다
#    비워 두면 npm run dev(stack.mjs) 가 무작위 32바이트(base64url)를 넣는다 (화면에 안 찍음 · Docker 없는 PC = node scripts/stack.mjs secrets)
#    잃으면 = 모든 MCP 연결을 다시 해야 한다 · DB 와 같이 새면 = 전원 토큰 노출 → 커밋 · 공유 금지
#    키 바꾸기: 새 키 = CONDUCTOR_SECRET_KEY + 새 CONDUCTOR_SECRET_KEY_ID · 옛 키는 CONDUCTOR_SECRET_KEYS_OLD=<id>:<키>,… 로 남겨 두면 읽힌다
CONDUCTOR_SECRET_KEY=
CONDUCTOR_SECRET_KEY_ID=
# CONDUCTOR_SECRET_KEYS_OLD=
# CONDUCTOR_MCP_ALLOW_LOOPBACK=1   # 테스트 전용: http://127.0.0.1 MCP 서버(가짜) 허용. BREWAI_E2E=1 이거나 CONDUCTOR_PUBLIC_URL 이 loopback 일 때만 켜진다

# ── 로컬 스택 (Docker, ADR-0009) — Cloud 안 씀
#    npm run stack = LiteLLM + 그 DB · npm run stack:trace = + Langfuse 묶음 · npm run dev 는 Docker 가 켜져 있으면 스택 LiteLLM
#    비밀값(아래 빈 줄 · LITELLM_MASTER_KEY)은 비워 두면 npm run stack 이 처음 한 번 만든다 (이미 있는 값은 안 건드림 · 화면에 안 찍음)
#    바꾸려면 npm run stack:reset -- --yes 먼저 (Langfuse 는 처음 뜰 때만 계정·키를 만든다 = trace 다 지워짐)
# BREWAI_TRACE=1     # npm run dev 가 Langfuse 묶음도 올린다 (기본 = LiteLLM + DB, 가볍게)
# BREWAI_STACK=0     # Docker 를 안 쓰고 예전 venv 게이트웨이(npm run gateway)로
# LITELLM_PORT=4000  LANGFUSE_PORT=3000  LANGFUSE_MEDIA_PORT=9090   (모두 127.0.0.1 에만 뜬다 · LITELLM_PORT 를 바꾸면 LLM_GATEWAY_URL 도)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=dev@brewai.local      # http://localhost:3000 로그인 (비번 = 아래)
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=          # 정확히 64 hex
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
# conductor → 로컬 Langfuse (OTLP/HTTP, gRPC 불가). Authorization 은 LANGFUSE_PUBLIC_KEY:SECRET_KEY 로 만든다 (slice 03)
OTEL_SERVICE_NAME=conductor
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:3000/api/public/otel
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
